package com.example;

import net.minecraft.client.gui.DrawContext;
import net.minecraft.client.gui.screen.Screen;
import net.minecraft.text.Text;
import net.minecraft.util.Formatting;

public class MysticMenuScreen extends Screen {

    public MysticMenuScreen() {
        super(Text.literal("Mystic Menu"));
    }

    @Override
    public void render(
            DrawContext context,
            int mouseX,
            int mouseY,
            float delta
    ) {
        this.renderBackground(context);

        int centerX = this.width / 2;
        int centerY = this.height / 2;

        // Фон панели
        context.fill(
                centerX - 110,
                centerY - 100,
                centerX + 110,
                centerY + 100,
                0xE0101020
        );

        // Заголовок
        context.drawCenteredTextWithShadow(
                this.textRenderer,
                Text.literal("MYSTIC MENU")
                        .formatted(Formatting.LIGHT_PURPLE, Formatting.BOLD),
                centerX,
                centerY - 80,
                0xFFFFFF
        );

        // Кнопки
        drawButton(context, centerX, centerY - 35, "Modules");
        drawButton(context, centerX, centerY, "Settings");
        drawButton(context, centerX, centerY + 35, "Close");

        super.render(context, mouseX, mouseY, delta);
    }

    private void drawButton(
            DrawContext context,
            int centerX,
            int y,
            String text
    ) {
        context.fill(
                centerX - 75,
                y,
                centerX + 75,
                y + 25,
                0xFF35234D
        );

        context.drawCenteredTextWithShadow(
                this.textRenderer,
                Text.literal(text),
                centerX,
                y + 8,
                0xFFFFFFFF
        );
    }
}
