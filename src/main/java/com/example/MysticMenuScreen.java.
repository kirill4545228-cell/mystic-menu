package com.example;

import net.minecraft.client.gui.DrawContext;
import net.minecraft.client.gui.screen.Screen;
import net.minecraft.client.gui.widget.ButtonWidget;
import net.minecraft.text.Text;
import net.minecraft.util.Formatting;

public class MysticMenuScreen extends Screen {

    public MysticMenuScreen() {
        super(Text.literal("Mystic Menu"));
    }

    @Override
    protected void init() {
        int centerX = this.width / 2;
        int centerY = this.height / 2;

        this.addDrawableChild(
                ButtonWidget.builder(
                        Text.literal("Modules"),
                        button -> {
                            // Здесь добавим экран модулей
                        }
                ).dimensions(centerX - 75, centerY - 40, 150, 25).build()
        );

        this.addDrawableChild(
                ButtonWidget.builder(
                        Text.literal("Settings"),
                        button -> {
                            // Здесь добавим настройки
                        }
                ).dimensions(centerX - 75, centerY - 5, 150, 25).build()
        );

        this.addDrawableChild(
                ButtonWidget.builder(
                        Text.literal("Close"),
                        button -> this.close()
                ).dimensions(centerX - 75, centerY + 30, 150, 25).build()
        );
    }

    @Override
    public void render(
            DrawContext context,
            int mouseX,
            int mouseY,
            float delta
    ) {
        this.renderBackground(context);

        int centerX = this.width / 2;
        int centerY = this.height / 2;

        context.fill(
                centerX - 110,
                centerY - 100,
                centerX + 110,
                centerY + 100,
                0xE0101020
        );

        context.drawCenteredTextWithShadow(
                this.textRenderer,
                Text.literal("MYSTIC MENU")
                        .formatted(Formatting.LIGHT_PURPLE, Formatting.BOLD),
                centerX,
                centerY - 75,
                0xFFFFFFFF
        );

        super.render(context, mouseX, mouseY, delta);
    }

    @Override
    public void close() {
        if (this.client != null) {
            this.client.setScreen(null);
        }
    }
}
